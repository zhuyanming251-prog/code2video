<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=1920, height=1080">
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        width: 1920px;
        height: 1080px;
        overflow: hidden;
        background: #000;
      }
      body {
        font-family: "Inter", sans-serif;
      }
      code,
      pre,
      .monospace {
        font-family: "JetBrains Mono", monospace;
      }
    </style>
  </head>
  <body>
    <div data-hf-id="hf-nkas" id="root" data-composition-id="my-video" data-start="0" data-duration="4.88" data-width="1920" data-height="1080">
      <!-- 1. Timed text clip on track 0 -->
      
    </div>

    <!-- 2–3. Paused GSAP timeline, registered for seekable render -->
    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      tl.from("#title", { opacity: 0, y: -50, duration: 1 }, 0);
      window.__timelines["my-video"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
